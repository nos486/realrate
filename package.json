{
  "name": "realrate-monorepo",
  "version": "1.0.0",
  "description": "RealRate — Iranian Gold & Currency Calculator (Monorepo)",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "api:dev": "npm run dev --workspace=api",
    "web:dev": "npm run dev --workspace=web",
    "dev": "concurrently \"npm run api:dev\" \"npm run web:dev\"",
    "api:deploy": "npm run deploy --workspace=api",
    "web:deploy": "npm run deploy --workspace=web"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
