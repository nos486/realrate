# RealRate website inside its container: the built files, routed and cached like Cloudflare Pages
# (the rules mirror web/public/_headers and the _redirects build-seo.mjs writes). Plain HTTP on
# :80 in the container; TLS and the domain are the host's nginx (docs/SELF_HOST.md).
{
	auto_https off
	admin off
}

:80 {
	root * /srv
	encode zstd gzip

	# Client routes of the app (generated from _redirects): served by the SPA shell
	import /etc/caddy/spa-routes.caddy

	@noindex path /p/* /spa /spa.html
	header @noindex X-Robots-Tag noindex

	@nocache path /sw.js /manifest.webmanifest
	header @nocache Cache-Control "no-cache"

	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@seo path /seo/*
	header @seo Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

	@og path /og/*
	header @og Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	@revalidate not path /assets/* /seo/* /og/* /sw.js /manifest.webmanifest
	header @revalidate Cache-Control "public, max-age=0, must-revalidate"

	handle @spa {
		rewrite * /spa.html
		file_server
	}

	# Static pages: /faq → faq.html, /features/loans → features/loans.html
	handle {
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
