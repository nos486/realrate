# RealRate on one Linux host: the website and the API, with automatic HTTPS (Let's Encrypt)
#   WEB_DOMAIN  the website        (e.g. realrate.ir)
#   API_DOMAIN  the API            (e.g. realrate-api.geekio.org — the Android app calls this one)
#   API_PORT    where the API listens on this host (127.0.0.1)
# The rules mirror web/public/_headers and the _redirects build-seo.mjs writes for Cloudflare Pages.
#   EDGE        "direct"     — the domains point straight at this host (DNS only): Let's Encrypt
#                              certificates, obtained as soon as DNS points here (ports 80 / 443)
#               "cloudflare" — behind Cloudflare's proxy (orange cloud, SSL mode "Full"): Caddy's
#                              own certificate for the Cloudflare → host leg
# Either way the client's address is the connection's, or Cloudflare's Cf-Connecting-Ip only when
# the request really comes from Cloudflare (trusted_proxies), so it cannot be forged.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip
	}
}

(tls_direct) {
}

(tls_cloudflare) {
	tls internal
}

{$WEB_DOMAIN} {
	import tls_{$EDGE:direct}
	root * /srv
	encode zstd gzip

	# Client routes of the app (generated from _redirects): served by the SPA shell
	import /etc/caddy/spa-routes.caddy

	@noindex path /p/* /spa /spa.html
	header @noindex X-Robots-Tag noindex

	@nocache path /sw.js /manifest.webmanifest
	header @nocache Cache-Control "no-cache"

	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@seo path /seo/*
	header @seo Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

	@og path /og/*
	header @og Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	@revalidate not path /assets/* /seo/* /og/* /sw.js /manifest.webmanifest
	header @revalidate Cache-Control "public, max-age=0, must-revalidate"

	handle @spa {
		rewrite * /spa.html
		file_server
	}

	# Static pages: /faq → faq.html, /features/loans → features/loans.html
	handle {
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

{$API_DOMAIN} {
	import tls_{$EDGE:direct}
	encode zstd gzip
	reverse_proxy 127.0.0.1:{$API_PORT:8787} {
		# The real client (see trusted_proxies above); a Cf-Connecting-Ip a client sends is dropped
		header_up -Cf-Connecting-Ip
		header_up X-Real-IP {client_ip}
	}
}
