# RealRate website: the Vite build + static SEO pages, served by Caddy (with HTTPS for both domains)
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY api/package.json api/
COPY web/package.json web/
RUN npm ci --workspace=web --include-workspace-root=false --no-audit --no-fund

# web/src/utils links into api/src/domain (shared modules)
COPY api/src api/src
COPY web web
COPY deploy/redirects-to-caddy.mjs deploy/
RUN npm run build --workspace=web \
  && node deploy/redirects-to-caddy.mjs web/dist/_redirects > /app/spa-routes.caddy \
  && rm -f web/dist/_redirects web/dist/_headers

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/spa-routes.caddy /etc/caddy/spa-routes.caddy
COPY --from=build /app/web/dist /srv
