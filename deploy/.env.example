# RealRate self-hosted — copy to deploy/.env and fill in (never commit deploy/.env)

# ── Domains (keep today's ones: the Android app has the API's address built in) ──
WEB_DOMAIN=realrate.ir
API_DOMAIN=realrate-api.geekio.org
API_PORT=8787
# cloudflare: the domains stay proxied by Cloudflare (orange cloud, SSL/TLS mode "Full") — the
#             switch has no DNS delay; direct: DNS only (grey cloud), Let's Encrypt certificates
EDGE=cloudflare

# ── Postgres on this host (the same database Hyperdrive uses today: no data to move) ──
DATABASE_URL=postgres://realrate:CHANGE_ME@127.0.0.1:5432/realrate
PG_POOL_MAX=20

# Per-minute jobs (price sync, reminders, cleanup). Keep false while the Cloudflare Worker's
# cron still runs; turn on when you switch it off (see docs/SELF_HOST.md)
CRON_ENABLED=false

# ── From api/wrangler.toml [vars] ──
ADMIN_EMAIL=nos486@gmail.com
GOOGLE_CLIENT_ID=420432138114-sfg3n1k34ke674192pct6envne50o1c7.apps.googleusercontent.com
DEFAULT_GOLD_USD=4000
DEFAULT_USD_TOMAN=

# ── Secrets: the same values as the Worker's (`wrangler secret list` shows their names) ──
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://realrate-api.geekio.org/api/auth/google/callback
FRONTEND_URL=https://realrate.ir
RESEND_API_KEY=
EMAIL_FROM=
GEMINI_API_KEY=
GITHUB_TOKEN=
BRS_API_KEY=
DEMO_VAULT_PASSPHRASE=
# Web Push: must be the SAME keys as now, or browsers already subscribed stop getting reminders
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
