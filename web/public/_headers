# The service worker and manifest must always be revalidated, or users can get stuck on an
# old worker for up to a day
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Content-hashed build output never changes
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Disallow indexing of private or raw SPA shell responses
/p/*
  X-Robots-Tag: noindex
/spa
  X-Robots-Tag: noindex
/spa.html
  X-Robots-Tag: noindex

# SEO page assets are not content-hashed: cache them for a while, not forever
# (seo.css is linked with ?v=<hash>, so a change still shows up at once)
/seo/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
